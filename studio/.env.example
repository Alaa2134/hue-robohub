# BuildX AI Studio Pro — server settings (API + worker). Copy to .env and fill in.
# Everything here stays on the server. The browser only ever receives SUPABASE_URL and SUPABASE_ANON_KEY.

NODE_ENV=production
PORT=8787
# The address people reach the API at (signed file links and uploads point here).
PUBLIC_API_URL=https://studio-api.buildxhue.com
# Pages allowed to call the API.
CORS_ORIGINS=https://buildxhue.com,https://www.buildxhue.com
# 32+ random characters (openssl rand -hex 32). Signs upload tickets and file links.
STUDIO_SECRET=

# ── Database ────────────────────────────────────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (Session pooler, port 5432).
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=1
REDIS_URL=redis://redis:6379

# ── Sign-in ─────────────────────────────────────────────────────────────────────────────────────────
# supabase = the team's existing BuildX HUE accounts. (local = built-in test users, development only.)
STUDIO_AUTH=supabase
SUPABASE_URL=https://zrtfupdnfxxnguznphis.supabase.co
SUPABASE_ANON_KEY=
# Only if the project still uses the legacy shared JWT secret (otherwise its signing keys are fetched).
SUPABASE_JWT_SECRET=
# These people become studio admins the first time they sign in (comma-separated).
STUDIO_ADMIN_EMAILS=

# ── Files ───────────────────────────────────────────────────────────────────────────────────────────
# local    = on this server's disk (the /data volume) — free, no upload size limit beyond MAX_UPLOAD_MB.
# supabase = the private "studio" bucket (Supabase Free caps files at 50 MB; Pro allows large videos).
STUDIO_STORAGE=local
STUDIO_LOCAL_DIR=/data
STUDIO_BUCKET=studio
# Needed for STUDIO_STORAGE=supabase only. Never put it in the website.
SUPABASE_SERVICE_ROLE_KEY=

# ── Limits ──────────────────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=4096
PROJECT_STORAGE_MB=20480
MONTHLY_RENDER_MINUTES=300
MAX_RENDER_SECONDS=900
# 4K needs a strong server (≈4× the CPU time of 1080p).
ALLOW_4K=0
RENDER_CONCURRENCY=1
INGEST_CONCURRENCY=2

# ── AI (off unless a key is set; every AI call shows its estimated cost before it runs) ────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MONTHLY_USD=5

# Local development only (STUDIO_AUTH=local): email:password:role,…
# STUDIO_LOCAL_USERS=media@buildx.test:change-me:admin
