# ─── Core ────────────────────────────────────────────────────────────────
# Canonical public origin (no trailing slash). Used for SEO, CSRF origin checks and signed URLs.
APP_URL=http://localhost:3000
# 32+ random bytes, base64. `openssl rand -base64 48`
APP_SECRET=change-me-change-me-change-me-change-me-change-me
# 32 random bytes, base64. Encrypts TOTP secrets at rest. `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
# Set to 1 to route the public site to the maintenance page.
MAINTENANCE_MODE=0

# ─── Database (PostgreSQL 15+) ──────────────────────────────────────────
# Use the least-privileged application role here (see docs/DATABASE.md).
DATABASE_URL=postgres://robohub_app:password@localhost:5432/robohub
DATABASE_POOL_MAX=10
# Migrations run with a separate owner role.
DATABASE_MIGRATION_URL=

# ─── Cache / rate limiting ──────────────────────────────────────────────
# Required in production when running more than one instance.
REDIS_URL=

# ─── Object storage ─────────────────────────────────────────────────────
# local (dev / single node) or s3 (any S3-compatible: AWS S3, Cloudflare R2, MinIO, Supabase Storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_BUCKET=robohub-public
S3_PRIVATE_BUCKET=robohub-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# CDN origin in front of the public bucket, e.g. https://media.robohub.example
PUBLIC_MEDIA_BASE_URL=

# ─── Video ──────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# ─── Anti-abuse ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Email (password resets, notifications) ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="HUE RoboHub <no-reply@robohub.example>"

# ─── Uploads ────────────────────────────────────────────────────────────
# Optional ClamAV daemon for scanning private documents.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ─── Observability ──────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hue-robohub

# ─── Analytics (privacy-respecting, optional) ──────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ─── AI assistant (optional; core features never depend on it) ─────────
ANTHROPIC_API_KEY=
